# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git!
# ============================================================

# App
PROJECT_NAME="מערכת אנו בניך"
API_V1_STR=/api/v1

# Deployment environment: development | dev | local | test | production
# Anything other than the first four enforces the SECRET_KEY rules below,
# so every hosted deployment must set ENVIRONMENT=production.
ENVIRONMENT=development

# Security – generate with: openssl rand -hex 32
# The placeholder below works in development only. With ENVIRONMENT=production
# the app refuses to start until this is replaced by a real key of at least
# 32 characters.
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Private message encryption (AES-256-GCM) – generate with: openssl rand -hex 32
# Same production requirements as SECRET_KEY above.
MESSAGE_ENCRYPTION_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10

# Database
# Development (SQLite):
DATABASE_URL=sqlite:///./dev.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/anu_banayich

# CORS – Angular dev server
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://localhost:3000"]

# Email (SMTP) – leave blank in dev to log emails to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@anu-banayich.org.il
EMAIL_FROM_NAME=עמותת "אנו בניך"

# Firebase (Google Sign-In) – required for verifying /auth/google ID tokens
FIREBASE_PROJECT_ID=

# File storage (S3 / Azure Blob) – leave blank in dev
STORAGE_BUCKET=
STORAGE_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI agent – LLM provider (ABF-121 / ABF-122)
# Get a key at https://aistudio.google.com/apikey. Without it the agent
# returns 503 for any question its knowledge base covers — a missing key is a
# fault, not a fallback. Questions outside the knowledge base still answer
# (with the referral to human advice), because no provider is called for them.
GEMINI_API_KEY=
# Which llm_service provider generates the answer. Changing this value is the
# only change needed to move to another provider – no calling code touches it.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=20

# AI agent – conversation limits (optional – defaults defined in config.py)
# Messages one user may send to the agents per rolling 24h, across all agents.
AGENT_RATE_LIMIT_PER_DAY=30
# Longest question accepted, in characters (422 above it).
AGENT_MAX_MESSAGE_LENGTH=1000
# How many past turns (question + answer) are replayed into the prompt.
AGENT_HISTORY_TURNS=3

# Moderation thresholds (optional – defaults defined in config.py)
AUTO_HIDE_REPORT_COUNT=2
AUTO_SUSPEND_VALID_REPORTS=3
AUTO_SUSPEND_HOURS=48
