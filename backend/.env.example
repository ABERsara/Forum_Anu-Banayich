# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git!
# ============================================================

# App
PROJECT_NAME="מערכת אנו בניך"
API_V1_STR=/api/v1

# Deployment environment: development | dev | local | test | production
# Anything other than the first four enforces the SECRET_KEY rules below,
# so every hosted deployment must set ENVIRONMENT=production.
ENVIRONMENT=development

# Security – generate with: openssl rand -hex 32
# The placeholder below works in development only. With ENVIRONMENT=production
# the app refuses to start until this is replaced by a real key of at least
# 32 characters.
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Private message encryption (AES-256-GCM) – generate with: openssl rand -hex 32
# Same production requirements as SECRET_KEY above.
MESSAGE_ENCRYPTION_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10

# Database
# Development (SQLite):
DATABASE_URL=sqlite:///./dev.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/anu_banayich

# CORS – Angular dev server
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://localhost:3000"]

# Email (SMTP) – leave blank in dev to log emails to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@anu-banayich.org.il
EMAIL_FROM_NAME=עמותת "אנו בניך"

# Firebase (Google Sign-In) – required for verifying /auth/google ID tokens
FIREBASE_PROJECT_ID=

# Google Calendar / Meet (ABF-156) – required for scheduling meetings.
# A separate grant from FIREBASE_PROJECT_ID above: that one only verifies who
# the caller is, this one creates events in a professional's own calendar.
# Create an OAuth client (type "Web application") in the Google Cloud console,
# enable the Calendar API, and register GOOGLE_REDIRECT_URI_MEET below as an
# authorised redirect URI – it must match character for character.
# Leave blank to disable scheduling; everything else in the API still runs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.events
# The API's own callback, not an Angular route (see config.py).
# Production: https://<render-domain>/api/v1/meetings/calendar/callback
GOOGLE_REDIRECT_URI_MEET=http://localhost:8000/api/v1/meetings/calendar/callback
# The page in the Angular app the professional lands back on after consent.
GOOGLE_CALENDAR_RETURN_URL=http://localhost:4200/meetings
# Google Calendar needs an end time; the scheduling form asks only for a start.
MEETING_DEFAULT_DURATION_MINUTES=60
GOOGLE_CALENDAR_TIMEOUT_SECONDS=10

# Gemini embeddings (agent knowledge base) – leave blank in dev to disable
# indexing; entries still save, they just are not retrievable until re-indexed.
# GEMINI_EMBED_MODEL is tied to the vector(768) column – a model that cannot
# return 768 dimensions needs a migration and a re-index, not just a new value
# here. Google retires embedding models on a published schedule, so check
# https://ai.google.dev/gemini-api/docs/deprecations before changing it.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=10

# AI agent answers (ABF-122). The same GEMINI_API_KEY above serves both the
# embeddings and the generation; LLM_PROVIDER decides who generates. Without a
# key, a question the knowledge base *does* cover comes back 503 rather than a
# quiet "I have no information" — a missing key has to look like a fault, not
# like an answer. A question it does not cover still works with no key at all.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=20

# Conversation limits. Tunable per deployment without a code change:
# AGENT_RATE_LIMIT_PER_DAY is per user over a rolling 24 hours and is shared by
# every agent; AGENT_MAX_MESSAGE_LENGTH is a 422 above it; AGENT_HISTORY_TURNS
# is how many earlier question+answer pairs are replayed into the prompt, which
# is what makes a follow-up like "ומה לגבי הילדים שלי" answerable — and what it
# costs in tokens on every turn. AGENT_MIN_RELEVANCE_SCORE is how close a
# passage must be to the question to be quoted at all (1.0 identical, 0.0
# unrelated) — below it the agent refers the reader to human advice instead of
# answering from whatever happened to rank highest. Calibrate it against the
# real knowledge base; both failure directions are visible.
AGENT_RATE_LIMIT_PER_DAY=30
AGENT_MAX_MESSAGE_LENGTH=1000
AGENT_MIN_RELEVANCE_SCORE=0.35
AGENT_HISTORY_TURNS=3

# File storage (S3 / Azure Blob) – leave blank in dev
STORAGE_BUCKET=
STORAGE_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Moderation thresholds (optional – defaults defined in config.py)
AUTO_HIDE_REPORT_COUNT=2
AUTO_SUSPEND_VALID_REPORTS=3
AUTO_SUSPEND_HOURS=48

# Automatic restrictions (ABF-116, spec §5.3 / §7.2) – written here rather
# than inlined so they can be re-calibrated after the first real run.
# Direction A – the repeatedly-reported sender loses private-message sending:
DM_BLOCK_AFTER_REPORTS=3
DM_BLOCK_DAYS_WINDOW=30
DM_BLOCK_HOURS=48
# Direction B – the frequent false reporter drops to a daily allowance:
FALSE_REPORT_LIMIT=5
FALSE_REPORT_DAYS_WINDOW=30
RESTRICTED_REPORTS_PER_DAY=3
FALSE_REPORT_RESTRICTION_DAYS=30
